# Return the stored settings plus a bit of server state read from the Plex
# preferences in the plex-config volume (claimed? server name, version).

import json
import os
import subprocess
import sys
import xml.etree.ElementTree as ET

import agent

host = os.getenv("TRAEFIK_HOST", "")
paths = [p for p in os.getenv("MEDIA_PATHS", "").split(",") if p]

claimed = False
server_name = ""
version = ""
try:
    vol = subprocess.run(["podman", "volume", "inspect", "plex-config", "--format", "{{.Mountpoint}}"],
                         capture_output=True, text=True, check=True).stdout.strip()
    pref = os.path.join(vol, "Library", "Application Support", "Plex Media Server", "Preferences.xml")
    if os.path.isfile(pref):
        attrs = ET.parse(pref).getroot().attrib
        claimed = bool(attrs.get("PlexOnlineToken"))
        server_name = attrs.get("FriendlyName", "")
except Exception:
    pass
try:
    version = subprocess.run(["podman", "inspect", "plex", "--format",
                              '{{index .Config.Labels "org.opencontainers.image.version"}}'],
                             capture_output=True, text=True).stdout.strip()
except Exception:
    pass

config = {
    "host": host,
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": agent.get_route(os.environ["MODULE_ID"]).get("lets_encrypt", False),
    "network_mode": os.getenv("NETWORK_MODE", "bridge"),
    "media_paths": paths,
    "media_require_mount": os.getenv("MEDIA_REQUIRE_MOUNT", "true") != "false",
    "hw_transcoding": os.getenv("HW_TRANSCODING", "false") == "true",
    "timezone": os.getenv("TZ", "UTC"),
    "url": f"https://{host}/web" if host else "",
    "server_claimed": claimed,
    "server_name": server_name,
    "plex_version": version,
    "web_port": os.getenv("WEB_PORT", ""),
}
json.dump(config, fp=sys.stdout)
