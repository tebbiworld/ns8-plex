# Persist the settings and write the container env file (state/plex.env).
#
# state/environment (loaded by plex.service):
#   TRAEFIK_*            reverse-proxy settings
#   NETWORK_MODE         bridge | host
#   PLEX_NETWORK_ARGS    podman args for the chosen mode (word-split in the unit)
#   MEDIA_PATHS          comma-separated host paths of the media libraries
#   PLEX_MEDIA_MOUNTS    "--volume p:p:ro" for each media path
#   MEDIA_REQUIRE_MOUNT  pre-start guard: paths must be on a mounted filesystem
#   HW_TRANSCODING / PLEX_DEVICE_ARGS   pass /dev/dri into the container
#   TZ
#
# state/plex.env (--env-file): TZ, ADVERTISE_IP (custom access URL so clients
# reach the server through Traefik), PLEX_CLAIM (one-time claim token, only
# needed until the server is linked to a Plex account; ignored afterwards).

import json
import os
import sys

import agent

data = json.load(sys.stdin)

host = data["host"]
h2hs = data.get("http2https", True)
lets_encrypt = data.get("lets_encrypt", False)
agent.set_env("TRAEFIK_HOST", host)
agent.set_env("TRAEFIK_HTTP2HTTPS", h2hs)

web_port = os.environ["WEB_PORT"]
network_mode = data.get("network_mode") or "bridge"
if network_mode == "host":
    network_args = "--network=host"
else:
    network_mode = "bridge"
    network_args = f"--publish 127.0.0.1:{web_port}:32400"
agent.set_env("NETWORK_MODE", network_mode)
agent.set_env("PLEX_NETWORK_ARGS", network_args)

paths = []
for p in data.get("media_paths") or []:
    p = os.path.normpath((p or "").strip())
    if p and p != "/" and p not in paths:
        paths.append(p)
agent.set_env("MEDIA_PATHS", ",".join(paths))
agent.set_env("PLEX_MEDIA_MOUNTS", " ".join(f"--volume {p}:{p}:ro" for p in paths))
agent.set_env("MEDIA_REQUIRE_MOUNT", "true" if data.get("media_require_mount", True) else "false")

hw = bool(data.get("hw_transcoding", False))
agent.set_env("HW_TRANSCODING", "true" if hw else "false")
agent.set_env("PLEX_DEVICE_ARGS", "--device=/dev/dri:/dev/dri" if hw else "")

timezone = data.get("timezone") or "UTC"
agent.set_env("TZ", timezone)

# --- Container env file ------------------------------------------------------
scheme = "https" if (lets_encrypt or h2hs) else "http"
port = 443 if scheme == "https" else 80
advertise = [f"{scheme}://{host}:{port}"]
lines = [
    "# Generated by configure-module. Do not edit by hand.",
    f"TZ={timezone}",
    # Custom server access URL(s): how clients reach this server from outside
    # the container network. Plex also keeps its own LAN/relay connections.
    f"ADVERTISE_IP={','.join(advertise)}",
    # Keep the plex user's default ids; media is mounted read-only and must be
    # world-readable (rootless: foreign owners appear as nobody).
    "CHANGE_CONFIG_DIR_OWNERSHIP=true",
]
claim = (data.get("plex_claim") or "").strip()
if claim:
    # Consumed at the next container start; tokens expire after a few minutes,
    # so it is deliberately not persisted anywhere else.
    lines.append(f"PLEX_CLAIM={claim}")
with open("plex.env.tmp", "w") as fp:
    fp.write("\n".join(lines) + "\n")
os.replace("plex.env.tmp", "plex.env")
