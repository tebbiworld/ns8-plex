# Copy the settings of the original instance. The server identity and its
# plex.tv token come back with the restored plex-config volume, so the server
# stays claimed and no new claim token is needed.

import json
import sys

import agent

request = json.load(sys.stdin)
env = request["environment"]

KEEP = ["TRAEFIK_HOST", "TRAEFIK_HTTP2HTTPS", "TRAEFIK_LETS_ENCRYPT", "NETWORK_MODE", "MEDIA_PATHS",
        "MEDIA_REQUIRE_MOUNT", "HW_TRANSCODING", "TZ"]

agent.mset_env({k: env[k] for k in KEEP if k in env})
